# --- Neon (PostgreSQL) ---------------------------------------------------------------
# Copiá este archivo a .env.local y completá los valores. .env.local NO se commitea.
#
# Runtime de la app: connection string POOLED (el host tiene "-pooler"). La usa Drizzle en la app.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Migraciones y seed: connection string DIRECTA (mismo host SIN "-pooler"). La usa drizzle-kit.
DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# --- Auth.js (NextAuth v5) -----------------------------------------------------------
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# En producción: URL pública de la app. En local no hace falta.
# AUTH_URL=https://twinchain.vercel.app

# --- Google OAuth (todavía no se usa; se suma más adelante) ---------------------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Microservicio de línea base (twinchain-ml: modelo de ML de vendedores) ----------------
# Sin esto la app funciona igual: solo la pantalla "Modelo de línea base" avisa que no hay servicio.
# En local:       cd twinchain-ml && .venv/bin/uvicorn api:app --port 8001   (ver twinchain-ml/README.md)
# En producción:  la URL del servicio en Render.
# ML_SERVICE_URL=http://127.0.0.1:8001
# Clave compartida con el servicio (header x-api-key). En Render la genera render.yaml; copiarla acá.
# ML_API_KEY=
